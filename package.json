{
  "name": "plancia-ui",
  "version": "0.7.0",
  "description": "Design system for dense consoles: CSS tokens, base styles and Svelte 5 components, dark by birth and light by choice. Ships a usage guide for AI coding agents.",
  "author": {
    "name": "Sidereus Team",
    "email": "sidereus.team@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tabrigos/plancia-ui.git"
  },
  "homepage": "https://tabrigos.github.io/plancia-ui/",
  "bugs": {
    "url": "https://github.com/Tabrigos/plancia-ui/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./labels": {
      "types": "./dist/labels.d.ts",
      "default": "./dist/labels.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && svelte-package -i src -o dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "design-system",
    "css-variables",
    "design-tokens",
    "dark-theme",
    "light-theme",
    "dashboard",
    "mission-control",
    "agent-skills"
  ]
}
