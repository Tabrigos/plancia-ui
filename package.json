{
  "name": "plancia-ui",
  "version": "0.3.0",
  "description": "Tema \"plancia\" (sala di comando): token, stili base e componenti Svelte 5 per console dense, scure o chiare. Nato in Sidereus, pensato per essere riusato.",
  "author": "Paolo Guerrera",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tabrigos/plancia-ui.git"
  },
  "homepage": "https://github.com/Tabrigos/plancia-ui#readme",
  "bugs": {
    "url": "https://github.com/Tabrigos/plancia-ui/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && svelte-package -i src -o dist",
    "prepublishOnly": "npm run build",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.0",
    "typescript": "~7.0.2"
  },
  "keywords": [
    "svelte",
    "design-system",
    "dark",
    "light",
    "dashboard",
    "mission-control"
  ]
}
