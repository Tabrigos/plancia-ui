{
  "name": "plancia-ui",
  "version": "0.2.0",
  "description": "Tema \"plancia\" (sala di comando): token, stili base e componenti Svelte 5 per console dense e scure. Nato in Sidereus, pensato per essere riusato.",
  "license": "MIT",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "keywords": [
    "svelte",
    "design-system",
    "dark",
    "dashboard",
    "mission-control"
  ]
